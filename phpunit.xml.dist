<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Use a database dedicated to running tests — NOT the same database as your local dev site. -->
        <env name="DB_DSN" value="mysql:host=db;port=3306;dbname=test"/>
        <env name="DB_USER" value="db"/>
        <env name="DB_PASSWORD" value="db"/>
        <env name="DB_SCHEMA" value="public"/>
        <env name="DB_TABLE_PREFIX" value=""/>
    </php>
</phpunit>
